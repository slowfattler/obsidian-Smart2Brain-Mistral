{
  "name": "obsidian-mistral-assistant",
  "version": "1.0.0",
  "description": "An Obsidian plugin to interact with Mistral AI models",
  "main": "main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --mode development --watch",
    "build": "vite build --mode production",
    "build:copy": "npm run build && cp build/main.js . && rm -rf build",
    "check": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.0",
    "builtin-modules": "^4.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  }
}
